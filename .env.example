# Cloudflare API token with Workers edit permissions.
# Generate at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Cloudflare account ID.
# Find it in the Cloudflare dashboard sidebar or at: https://dash.cloudflare.com/
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Microsoft Clarity tracking ID for analytics.
# Find it in your Clarity project settings: https://clarity.microsoft.com/
NEXT_PUBLIC_CLARITY_TRACKING_ID=your_clarity_tracking_id_here
