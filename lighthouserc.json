{
  "ci": {
    "collect": {
      "startServerCommand": "bunx astro preview",
      "startServerReadyPattern": "ready in",
      "startServerReadyTimeout": 30000,
      "numberOfRuns": 3,
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/about",
        "http://localhost:4321/blog",
        "http://localhost:4321/contact",
        "http://localhost:4321/hello-world-i-finally-beat-procrastination"
      ],
      "settings": {
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*/blog/?$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2500, "aggregationMethod": "median" }],
            "total-byte-weight": ["error", { "maxNumericValue": 512000, "aggregationMethod": "median" }],
            "unsized-images": ["error", { "minScore": 1, "aggregationMethod": "median" }]
          }
        },
        {
          "matchingUrlPattern": "^(?!.*/blog/?$).*$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2500, "aggregationMethod": "median" }],
            "total-byte-weight": ["error", { "maxNumericValue": 307200, "aggregationMethod": "median" }],
            "unsized-images": ["error", { "minScore": 1, "aggregationMethod": "median" }]
          }
        }
      ]
    }
  }
}
