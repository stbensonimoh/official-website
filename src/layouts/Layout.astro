---
import "../styles/global.css";
import siteMetadata from "../../siteMetadata";
import Header from "../components/Header.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import { cloudinaryUrl } from "../lib/cloudinary";

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string | URL;
  preloadImage?: string;
  preloadImageSet?: string;
  preloadImageSizes?: string;
}

const {
  title = siteMetadata.title,
  description = siteMetadata.description,
  ogImage = "https://res.cloudinary.com/stbensonimoh/image/upload/v1735318948/stbensonimoh_logo.png",
  canonicalURL,
  preloadImage,
  preloadImageSet,
  preloadImageSizes,
} = Astro.props;

const clarityId = import.meta.env.PUBLIC_CLARITY_TRACKING_ID;

// Analytics decisions (issue #189):
// 1. Microsoft Clarity is deferred. The official queue function is installed
//    in <head> so events still queue, but the tag script loads only on the
//    first interaction, or once the page has finished loading and the browser
//    is idle. That keeps the 731 B loader and the ~26 KB runtime off the
//    critical path, away from LCP and the page's own rendering.
// 2. The Cloudflare Web Analytics beacon is injected by the Cloudflare edge,
//    not by this repository, so it cannot be changed in code. Verified in the
//    production HTML: `static.cloudflareinsights.com/beacon.min.js` appears in
//    the served markup. Decision: keep it. It is a `type="module"` script that
//    runs after HTML parsing (not render-blocking, ~10 KB), and its real-user
//    Core Web Vitals data feeds the performance epic. To remove it, turn Web
//    Analytics off in the Cloudflare dashboard.
// 3. Clarity counts soft navigations itself (issue #210). Its runtime wraps
//    history.pushState and history.replaceState; a changed URL stops the
//    session and starts a new one 250 ms later (the default `restart` delay).
//    Source: the served 0.8.72-beta runtime at
//    scripts.clarity.ms/0.8.72-beta/clarity.js. ClientRouter navigates with
//    pushState, so astro:page-load needs no hook, and Clarity exposes no
//    page-view API to call there. The head swap dropping the tag node does
//    not matter; the runtime and its history proxy live on window. Known
//    exception: because the tag is deferred (#212), a first click in the
//    seconds after a cold load races the runtime download against the
//    router's fetch. When the runtime loses, pushState runs before history
//    is wrapped, so the departing page is never counted and the runtime's
//    first page view is the new URL. Bounded to that first navigation, and
//    the accepted cost of the deferral.

const pageTitle = title === siteMetadata.title ? title : `${title} - ${siteMetadata.title}`;
// `build.format: 'file'` yields paths like `/about.html`; keep canonical and og URLs extensionless.
const pageUrl = (canonicalURL ? String(canonicalURL) : String(Astro.url))
  .replace(/\.html$/, "")
  .replace(/\/index$/, "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={cloudinaryUrl(ogImage, { width: 1200, autoFormat: false })} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteMetadata.title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={cloudinaryUrl(ogImage, { width: 1200, autoFormat: false })} />
    <meta name="twitter:creator" content={`@${siteMetadata.social.x}`} />

    <link rel="canonical" href={pageUrl} />
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage}
        imagesrcset={preloadImageSet}
        imagesizes={preloadImageSet ? preloadImageSizes : undefined}
        fetchpriority="high"
      />
    )}
    <ClientRouter />

    <Font cssVariable="--astro-font-roboto" preload />
    <Font cssVariable="--astro-font-bebas" />
    <Font cssVariable="--astro-font-badscript" />
    <Font cssVariable="--astro-font-dosis" />

    <script is:inline>
      // Prevent FOUC: set theme before any rendering
      (function() {
        function applyTheme() {
          var theme = localStorage.getItem('theme') || 'system';
          if (theme === 'system') {
            theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', theme);
        }
        applyTheme();
        // ClientRouter's swap drops the root data-theme attribute and this
        // inline script does not re-run, so reapply the stored theme after the
        // swap and before paint (#209). The listener lives on document, which
        // survives the swap.
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
    {
      clarityId && (
        <script is:inline set:html={`(function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          if (c.__clarityDeferred) return;
          c.__clarityDeferred=1;
          var loaded=0;
          function load(){
            if(loaded)return;
            loaded=1;
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
          }
          ['pointerdown','touchstart','keydown'].forEach(function(n){
            c.addEventListener(n,load,{once:true,passive:true});
          });
          function idle(){
            if(typeof c.requestIdleCallback==='function'){
              c.requestIdleCallback(load,{timeout:2500});
            }else{
              c.setTimeout(load,2500);
            }
          }
          function schedule(){c.setTimeout(idle,3000);}
          if(l.readyState==='complete')schedule();
          else c.addEventListener('load',schedule,{once:true});
        })(window,document,"clarity","script","${clarityId}");`} />
      )
    }
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <ThemeToggle />

    <script is:inline data-astro-rerun>
      // Clarity tracking helper
      function track(name) {
        if (typeof window.clarity === 'function') {
          window.clarity('event', name);
        }
      }

      // Mobile menu toggle
      document.getElementById('menu-toggle')?.addEventListener('click', function() {
        var menu = document.getElementById('mobile-menu');
        var openIcon = document.getElementById('menu-icon-open');
        var closeIcon = document.getElementById('menu-icon-close');
        var isOpen = !menu.classList.contains('translate-y-[-100vh]');

        if (isOpen) {
          menu.classList.add('translate-y-[-100vh]');
          openIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
          this.setAttribute('aria-label', 'Open menu');
          track('mobile_menu_close');
        } else {
          menu.classList.remove('translate-y-[-100vh]');
          openIcon.classList.add('hidden');
          closeIcon.classList.remove('hidden');
          this.setAttribute('aria-label', 'Close menu');
          track('mobile_menu_open');
        }
      });

      // Theme toggle
      (function() {
        var THEME_KEY = 'theme';
        var themes = ['light', 'dark', 'system'];

        function getSystemTheme() {
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        function getTheme() {
          return localStorage.getItem(THEME_KEY) || 'system';
        }

        function getActualTheme() {
          var t = getTheme();
          return t === 'system' ? getSystemTheme() : t;
        }

        function applyTheme(theme) {
          document.documentElement.setAttribute('data-theme', theme);
        }

        function toggleTheme() {
          var current = getTheme();
          var idx = themes.indexOf(current);
          var next = themes[(idx + 1) % themes.length];
          localStorage.setItem(THEME_KEY, next);
          applyTheme(getActualTheme());
          updateIcon();
          track('theme_change_to_' + next);
        }

        function updateIcon() {
          var current = getTheme();
          document.querySelectorAll('[data-theme-icon]').forEach(function(el) {
            el.classList.add('hidden');
          });
          var icon = document.querySelector('[data-theme-icon="' + current + '"]');
          if (icon) icon.classList.remove('hidden');
        }

        // Listen for system theme changes
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
          if (getTheme() === 'system') {
            applyTheme(getSystemTheme());
          }
        });

        // Wire toggle button
        document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);

        // Init icon
        updateIcon();
      })();

      // Active nav link highlighting + tracking
      (function() {
        var currentPath = window.location.pathname;
        document.querySelectorAll('[data-nav]').forEach(function(link) {
          if (link.getAttribute('data-nav') === currentPath) {
            link.classList.add('active-menu-item');
          }
          link.addEventListener('click', function() {
            track('nav_click_' + (link.getAttribute('data-nav') || '').replace(/\//g, '_'));
          });
        });
      })();

      // Social icon click tracking
      document.querySelectorAll('[aria-label*="Profile"]').forEach(function(link) {
        link.addEventListener('click', function() {
          var label = link.getAttribute('aria-label') || '';
          var platform = label.replace(' Profile', '').toLowerCase();
          track('social_click_' + platform);
        });
      });
    </script>
  </body>
</html>
