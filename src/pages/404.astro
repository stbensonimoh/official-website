---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 - Page Not Found">
  <main>
    <div class="flex flex-col items-center justify-center font-roboto pt-60 md:pt-20 mx-10">
      <img
        src="/images/404.png"
        width="40%"
        alt="404 Image"
        style="margin-bottom: 1rem"
      />
      <h1 class="font-roboto font-bold text-bensonpink text-6xl">
        404
      </h1>
      <p class="my-6 text-center">
        Awww... Are you lost? It seems like the page you are looking for
        does not exist.
      </p>
      <a href="/" class="button border border-bensonpink py-4 px-6 font-roboto font-medium text-lg text-bensonpink">
        Let's go home
      </a>
    </div>
  </main>
</Layout>
