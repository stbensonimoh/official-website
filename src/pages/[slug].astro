---
import { getCollection, getEntry, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import AuthorBlob from "../components/AuthorBlob.astro";
import { getReadingTime } from "../lib/posts";
import { cloudinaryUrl } from "../lib/cloudinary";

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.data.slug || post.id },
  }));
}

const { slug } = Astro.params;
const post = await getEntry("blog", slug!);

if (!post) {
  throw new Error(`Unknown blog slug: ${slug}`);
}

const { Content } = await render(post);
const readingTime = getReadingTime(post.body || "");
const postSlug = post.data.slug || post.id;
const formattedDate = post.data.pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const heroImageUrl = post.data.heroImage
  ? cloudinaryUrl(post.data.heroImage, { width: 1600 })
  : undefined;
const heroImageSet = post.data.heroImage
  ? [800, 1200, 1600]
      .map((w) => `${cloudinaryUrl(post.data.heroImage, { width: w })} ${w}w`)
      .join(", ")
  : undefined;
const heroWidth = 1600;
const heroHeight =
  post.data.heroImageWidth && post.data.heroImageHeight
    ? Math.round(heroWidth * (post.data.heroImageHeight / post.data.heroImageWidth))
    : Math.round((heroWidth * 9) / 16);
---

<Layout
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.heroImage}
  canonicalURL={`https://stbensonimoh.com/${postSlug}`}
  preloadImage={heroImageUrl}
  preloadImageSet={heroImageSet}
  preloadImageSizes="100vw"
>
  <main class="flex flex-col w-full">
    {
      heroImageUrl && (
        <div class="featured-image overflow-hidden" style="height: calc(100vh - 400px)">
          <img
            src={heroImageUrl}
            srcset={heroImageSet}
            sizes="100vw"
            width={heroWidth}
            height={heroHeight}
            alt=""
            class="h-full w-full object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )
    }
    <div
      class="w-11/12 lg:w-4/5 xl:w-3/4 bg-background self-center h-60 relative bottom-36"
      style="box-shadow: 0px -20px 20px rgba(0, 0, 0, 0.2)"
    ></div>
    <div class="w-11/12 lg:w-4/5 xl:w-3/4 px-10 md:px-20 lg:px-20 xl:px-20 self-center relative bottom-72">
      <h1 class="my-4 text-3xl md:text-5xl font-roboto font-medium text-primary">
        {post.data.title}
      </h1>
      <AuthorBlob date={formattedDate} timeToRead={readingTime.text} />
      <article class="prose max-w-none font-roboto text-lg font text-foreground">
        <Content />
      </article>
      {
        post.data.tags && post.data.tags.length > 0 && (
          <p class="text-primary text-lg mt-8">
            Tags: {post.data.tags.map((tag: string) => `#${tag} `)}
          </p>
        )
      }
    </div>
  </main>
</Layout>
