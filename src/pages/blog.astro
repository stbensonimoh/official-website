---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import BlogPostCard from "../components/BlogPostCard.astro";
import { getReadingTime } from "../lib/posts";

const posts = await getCollection("blog");
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog">
  <div class="font-roboto max-w-4xl mx-auto px-4 py-12">
    <h1 class="font-bebas text-4xl mb-8">Blog</h1>
    {
      posts.length === 0 ? (
        <p>No posts yet.</p>
      ) : (
        <div class="space-y-8">
          {posts.map((post) => (
            <BlogPostCard
              slug={post.data.slug || post.id}
              title={post.data.title}
              date={post.data.pubDate.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
              description={post.data.description}
              heroImage={post.data.heroImage || ""}
              readingTime={getReadingTime(post.body || "").text}
            />
          ))}
        </div>
      )
    }
  </div>
</Layout>
