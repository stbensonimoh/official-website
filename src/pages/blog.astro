---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const posts = await getCollection("blog");
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog">
  <div class="font-roboto max-w-3xl mx-auto px-4 py-12">
    <h1 class="font-bebas text-4xl mb-8">Blog</h1>
    {
      posts.length === 0 ? (
        <p>No posts yet.</p>
      ) : (
        <ul class="space-y-8">
          {posts.map((post) => (
            <li>
              <a href={`/${post.data.slug || post.id}`} class="group block">
                <h2 class="text-2xl font-bold group-hover:text-primary transition-colors">
                  {post.data.title}
                </h2>
                <p class="text-secondary text-sm mt-1">
                  {post.data.pubDate.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </p>
                <p class="mt-2 text-foreground">{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Layout>
