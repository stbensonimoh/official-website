---
import Layout from "../layouts/Layout.astro";
import SocialIcons from "../components/SocialIcons.astro";
import Copyright from "../components/Copyright.astro";
import { getImage } from "astro:assets";
import frontImage from "../assets/images/front-image.png";

export const prerender = true;

// The page renders the hero twice, once per layout, and CSS hides one copy at
// each breakpoint. Gate the real sources to the same breakpoints Tailwind
// emits for `md:hidden` and `md:flex`, in the same units: rem in a media query
// resolves against the browser's default font-size setting, not the page root,
// so a px condition stays fixed while the CSS breakpoint moves with that
// setting. The img fallback is a transparent pixel so the hidden copy never
// triggers a network request.
const heroSizes = "(min-width: 768px) 40vw, 100vw";
const heroSources = await Promise.all(
  (["avif", "webp"] as const).map(async (format) => ({
    format,
    image: await getImage({
      src: frontImage,
      format,
      widths: [400, 600, 900, 1200],
    }),
  })),
);
const transparentPixel =
  "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";
---

<Layout>
  <div class="font-roboto">
    <div class="hidden md:flex items-center justify-center mt-12 md:mx-4 xl:mx-0">
      <div class="flex flex-col mx-10 w-1/2 lg:w-1/3">
        <h3 class="text-4xl font-roboto">Hello!</h3>
        <h4 class="text-2xl font-badscript">I am Benson...</h4>
        <h1 class="font-bebas my-4 lg:text-3xl xl:text-5xl">
          Software Engineer <br />
          DevOps Enthusiast <br />
          OSS Advocate
        </h1>
        <p class="xl:w-4/5">
          I build software and infrastructure with the precision of an engineer and the curiosity of an artist, creatively and
          efficiently solving problems using bold ideas and experimental
          methods. I'm passionate about OSS and automating workflows.
        </p>
        <p class="pt-4 text-bensongrey xl:w-3/5">
          Deeply invested in improving DevX, Cx, and xD because how things feel is just as important as how they work.
        </p>
      </div>
      <div class="image-section mx-10 w-2/5">
        <picture>
          {heroSources.map(({ format, image }) => (
            <source
              media="(min-width: 48rem)"
              type={`image/${format}`}
              srcset={image.srcSet.attribute}
              sizes={heroSizes}
            />
          ))}
          <img
            src={transparentPixel}
            alt="Benson Imoh portrait"
            width={frontImage.width}
            height={frontImage.height}
            loading="eager"
            decoding="sync"
            fetchpriority="high"
          />
        </picture>
      </div>
    </div>
    <div class="mobile-header flex flex-col items-center pt-20 w-full md:hidden">
      <picture>
        {heroSources.map(({ format, image }) => (
          <source
            media="(width < 48rem)"
            type={`image/${format}`}
            srcset={image.srcSet.attribute}
            sizes={heroSizes}
          />
        ))}
        <img
          src={transparentPixel}
          alt="Benson Imoh portrait"
          width={frontImage.width}
          height={frontImage.height}
          loading="eager"
          decoding="async"
          class="my-12"
        />
      </picture>
      <div class="mobile-badge">
        SOFTWARE ENGINEER
      </div>
      <div class="mobile-badge">
        DEVOPS ENTHUSIAST
      </div>
      <div class="mobile-badge">
        OSS ADVOCATE
      </div>
    </div>
  </div>
  <SocialIcons class="absolute bottom-10 social-icons hidden md:flex flex-col w-8 ml-4 text-center text-bensongrey" />
  <div class="hidden md:flex copyright-container absolute right-24 bottom-8 font-roboto text-sm text-bensongrey">
    <Copyright />
  </div>
</Layout>
