{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": [
      "bun-types"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.astro"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test-setup.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/test-utils.*",
    "scripts/**/*"
  ]
}
